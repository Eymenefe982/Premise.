# --- NCBI / PubMed ---------------------------------------------------------
# E-posta zorunlu (NCBI kuralı). API anahtarı ücretsizdir ve hız limitini
# 3 istek/sn'den 10 istek/sn'ye çıkarır: https://account.ncbi.nlm.nih.gov/settings/
NCBI_EMAIL=ad.soyad@ornek.com
NCBI_API_KEY=

# --- Gemini (sentez motoru) ------------------------------------------------
# Birden fazla anahtarı virgülle ayırın; biri kotayı doldurunca diğerine geçilir.
GEMINI_API_KEYS=anahtar1,anahtar2
GEMINI_MODEL=gemini-3.6-flash

# --- Groq (Gemini kotası bitince devreye giren yedek) ----------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Yönetici hesabı -------------------------------------------------------
# Yalnızca ilk açılışta okunur ve hesap bir kez oluşturulur. Şifre veritabanına
# argon2 ile özetlenerek yazılır, düz metin hiçbir yerde saklanmaz.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Oturum ve şifreleme ---------------------------------------------------
# Boş bırakılırsa ilk açılışta üretilip veritabanında saklanır. Canlıda kendiniz
# belirlemeniz önerilir; SECRET_KEY bir Fernet anahtarı olmalıdır:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
SECRET_KEY=
ACCESS_TOKEN_HOURS=2
REFRESH_TOKEN_DAYS=30

# Canlıda 1 yapın: oturum çerezi yalnızca HTTPS üzerinden gönderilir.
COOKIE_SECURE=0
# Arayüz ayrı bir alan adından sunuluyorsa: https://premise.app,https://www.premise.app
ALLOWED_ORIGINS=

# --- İsteğe bağlı ayarlar --------------------------------------------------
FULLTEXT_TOP_N=5            # kaç makalenin PMC tam metni okunsun
FULLTEXT_CHAR_LIMIT=14000   # makale başına tam metin karakter sınırı
CACHE_ENABLED=1             # aynı soru tekrar sorulunca saklanan sonucu ver
CACHE_TTL_DAYS=7            # saklanan sonucun geçerlilik süresi
